{
  "version": 1,
  "errorPolicy": {
    "code": "signed 32-bit integer; ASCII whole numeric strings without whitespace; boolean/fraction/overflow rejected",
    "aliases": "first present key wins, canonical null does not fall through",
    "message": "strings preserved (including empty); finite primitive values described; null/missing/containers use Unknown Error"
  },
